            "content": "package main\n\nimport \"fmt\"\n\nfunc eh_primo(x int, div int) bool {\n\tif x <= 1 {\n\t\treturn false\n\t}\n\n\tif (x%div == 0) && (x != div) {\n\t\treturn false\n\t} else if div >= x {\n\t\treturn true\n\t}\n\n\treturn eh_primo(x, div+1)\n}\n\nfunc enesimo_primo(n int, contador int, primo int) int {\n\tif eh_primo(primo, 2) {\n\t\tcontador += 1\n\t\tif contador == n {\n\t\t\treturn primo\n\t\t}\n\t}\n\n\tprimo += 1\n\treturn enesimo_primo(n, contador, primo)\n}\n\nfunc main() {\n\tvar n int\n\n\tfmt.Scan(&n)\n\n\tfmt.Println(enesimo_primo(n, 0, 1))\n}\n",
