            "label": "2026-06-07_03-55-42",
            "content": "package main\n\nimport \"fmt\"\n\nfunc eh_primo(x int, div int) bool {\n\tif x <= 1 {\n\t\treturn false\n\t}\n\n\tif (x%div == 0) && (x != div) {\n\t\treturn false\n\t} else if div >= x {\n\t\treturn true\n\t}\n\n\treturn eh_primo(x, div+1)\n}\n\nfunc enesimo_primo(n int, contador int, primo int, vet []int) []int {\n\tif eh_primo(primo, 2) {\n\t\tcontador += 1\n\t\tvet = append(vet, primo)\n\t\tif contador == n {\n\t\t\treturn vet\n\t\t}\n\t}\n\n\tprimo += 1\n\treturn enesimo_primo(n, contador, primo, vet)\n}\n\nfunc main() {\n\tvar n int\n\tvar vet []int\n\tfmt.Scan(&n)\n\n\tvet = enesimo_primo(n, 0, 1, vet)\n\n\tfmt.Print(\"[\")\n\n\tfor i := 0; i <= len(vet)-1; i++ {\n\t\tif i != len(vet)-1 {\n\t\t\tfmt.Printf(\"%d, \", vet[i])\n\t\t} else {\n\t\t\tfmt.Print(vet[i])\n\t\t}\n\t}\n\tfmt.Println(\"]\")\n}\n",
