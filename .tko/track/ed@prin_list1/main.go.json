        {
            "label": "2026-07-02_19-26-33",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n)\n\n// mostra a lista com o elemento sword destacado\nfunc ToStr(l *DList[int], sword *DNode[int]) string {\n\tvar sb strings.Builder\n\n\tsb.WriteString(\"[ \")\n\tfor n := l.Front(); n != l.End(); n = n.Next() {\n\t\tif n == sword {\n\t\t\tsb.WriteString(fmt.Sprintf(\"%v>\", n.Value))\n\t\t} else {\n\t\t\tsb.WriteString(fmt.Sprintf(\"%v\", n.Value))\n\t\t}\n\n\t\tif n.Next() != l.End() {\n\t\t\tsb.WriteString(\" \")\n\t\t}\n\t}\n\tsb.WriteString(\" ]\")\n\treturn sb.String()\n}\n\n// move para frente na lista circular\nfunc Next(l *DList[int], it *DNode[int]) *DNode[int] {\n\tif it.next == l.End() {\n\t\treturn it.next.next\n\t}\n\treturn it.next\n}\n\nfunc main() {\n\tvar qtd, chosen int\n\tfmt.Scan(&qtd, &chosen)\n\t//fmt.Println(qtd, chosen)\n\tl := NewDList[int]()\n\tfor i := 1; i <= qtd; i++ {\n\t\tl.PushBack(i)\n\t}\n\tsword := l.Front()\n\tfor range chosen - 1 {\n\t\tsword = Next(l, sword)\n\t}\n\tfor range qtd - 1 {\n\t\tfmt.Println(ToStr(l, sword))\n\t\tl.Erase(Next(l, sword))\n\t\tsword = Next(l, sword)\n\t}\n\tfmt.Println(ToStr(l, sword))\n}\n",
